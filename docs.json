{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Argos Help Center",
  "description": "Help center for Argos — legal operations platform for in-house legal teams.",
  "colors": {
    "primary": "#18181B",
    "light": "#FFFFFF",
    "dark": "#18181B"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "getting-started/overview",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Matters",
        "icon": "folder-open",
        "expanded": true,
        "pages": [
          "matters/how-matters-work",
          "matters/filing-from-integrations",
          "matters/gmail-matter-filing",
          "matters/custom-fields"
        ]
      },
      {
        "group": "Ask Argos",
        "icon": "message-circle",
        "expanded": true,
        "pages": [
          "archive/asking-questions",
          "archive/cited-answers"
        ]
      },
      {
        "group": "Contract Review",
        "icon": "file-check",
        "expanded": true,
        "pages": [
          "contract-review/create-workflow",
          "contract-review/run-a-review",
          "contract-review/review-results"
        ]
      },
      {
        "group": "Integrations",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "integrations/gmail",
          "integrations/outlook",
          "integrations/slack",
          "integrations/google-drive",
          "integrations/sharepoint",
          "integrations/linear",
          "integrations/asana"
        ]
      },
      {
        "group": "Security & Compliance",
        "icon": "shield",
        "expanded": true,
        "pages": [
          "security/data-handling"
        ]
      },
      {
        "group": "Account & Billing",
        "icon": "circle-user",
        "expanded": true,
        "pages": [
          "account-billing/overview"
        ]
      },
      {
        "group": "Support",
        "icon": "life-buoy",
        "expanded": true,
        "pages": [
          "support/get-support"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}
